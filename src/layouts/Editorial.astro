---
import Base from './Base.astro';
import '@fontsource-variable/source-sans-3';
import '@fontsource-variable/source-sans-3/wght-italic.css';
import '../styles/editorial-theme.css';
import '../styles/inner-pages.css';
interface Props {
  title: string;
  label: string;
  description?: string;
  noindex?: boolean;
}
const { title, label, description, noindex = false } = Astro.props;
---

<Base title={title} description={description} noindex={noindex} editorial>
  <div class="inner-utility">
    <nav aria-label="Breadcrumb">
      <a href="/">QWERTY Labs</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{label}</span>
    </nav>
    <button
      id="reading-theme"
      class="reading-theme"
      type="button"
      aria-pressed="false"
      aria-label="Switch to dark reading theme"
    >
      <span class="theme-symbol" aria-hidden="true">
        ◐
      </span>
      <span data-theme-label>Dark reading</span>
    </button>
  </div>
  <slot />
  <script>
    import '../scripts/reading-theme';
  </script>
</Base>
