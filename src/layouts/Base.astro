---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { storageKeys, legacyStorageKeys } from '../scripts/browser-storage';
import '../styles/global.css';
import { siteConfiguration } from '../config/site';
import { siteIdentity, pageBreadcrumbs } from '../data/seo';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  journal?: boolean;
  editorial?: boolean;
  structuredData?: Record<string, unknown>;
  ogType?: 'website' | 'article';
}
const {
  title = 'SAMVIT Labs | Custom AI Solutions & Workflow Automation',
  description = 'Custom AI agents, chatbots, voice bots, speech-to-text and text-to-speech solutions for enterprises.',
  noindex = false,
  journal = false,
  editorial = false,
  structuredData,
  ogType = 'website',
} = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const socialImage = new URL('/brand/social-card.png', site).href;
const graph = [
  ...(Astro.url.pathname === '/'
    ? siteIdentity(site)
    : pageBreadcrumbs(Astro.url.pathname, title, site)),
  ...(structuredData ? [structuredData] : []),
];
const excludeFromSearch = noindex || !siteConfiguration().indexable;
---

<!doctype html>
<html
  lang="en"
  class:list={{ 'journal-page': journal, 'editorial-page': editorial }}
  data-reader-theme={journal || editorial ? 'light' : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="theme-color"
      content={journal || editorial ? '#faf9f5' : '#090d12'}
    />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="SAMVIT Labs" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="SAMVIT Labs — Custom AI built around your business"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={canonical} />
    {graph.length > 0 && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@graph': graph,
        }).replace(/</g, '\\u003c')}
      />
    )}
    {(journal || editorial) && <script
      is:inline
      define:vars={{
        themeStorageKey: storageKeys.readingTheme,
        legacyThemeStorageKey: legacyStorageKeys.readingTheme,
      }}
    >
      try {
        document.documentElement.dataset.readerTheme =
          (localStorage.getItem(themeStorageKey) ??
            localStorage.getItem(legacyThemeStorageKey)) === 'dark'
            ? 'dark'
            : 'light';
      } catch {}
    </script>}
    {excludeFromSearch && <meta name="robots" content="noindex, follow" />}
  </head>
  <body id="top">
    <Header />
    <slot />
    <Footer />
    <script>
      import '../scripts/navigation';
    </script>
  </body>
</html>
