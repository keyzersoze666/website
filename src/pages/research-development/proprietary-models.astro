---
import Editorial from '../../layouts/Editorial.astro';
import {
  modelDirections,
  deploymentOptions,
  evaluationStages,
} from '../../data/model-development';
import { publishedPosts } from '../../scripts/blog-content';
import '../../styles/model-development.css';
import { enquiryHref } from '../../data/enquiry-topics';

const readingIds = [
  'when-smaller-models-work-better',
  'distilling-domain-specific-small-models',
  'real-time-voice-agent-design',
];
const posts = await publishedPosts();
const reading = readingIds.flatMap((id) => {
  const post = posts.find((item) => item.id === id);
  return post ? [post] : [];
});
const groups = [
  {
    id: 'text',
    title: 'Text models',
    copy: 'Compact LLMs and SLMs, scoped around a task, its language and the information it needs.',
  },
  {
    id: 'voice',
    title: 'Voice models',
    copy: 'Specialised speech models, starting with a selected language, a clear purpose and representative audio.',
  },
];
---

<Editorial
  title="Proprietary Models — QWERTY Labs"
  label="Proprietary Models"
  description="Compact text and speech models in development for focused business tasks, practical self-hosting and greater control over data processing."
>
  <main id="main-content" class="destination-main development-main">
    <div class="container">
      <header class="development-hero">
        <div class="development-intro">
          <h1>Proprietary models</h1>
          <p class="development-status">
            <span aria-hidden="true"></span> In development
          </p>
          <p class="development-lead">
            Compact text and speech models for specific business tasks. Built
            towards a practical goal: running useful AI within an environment
            your organisation approves.
          </p>
          <p class="development-summary">
            We’re developing proprietary models with a focus on task quality,
            computing requirements and control over data processing. Once
            developed and validated, these models are intended for self-hosted
            deployment, operated by your team or managed by QWERTY Labs.
          </p>
          <a class="text-link" href="#directions">
            Explore the model directions
          </a>
        </div>
        <figure class="deployment-figure">
          <div
            class="deployment-drawing"
            role="img"
            aria-labelledby="deployment-diagram-title"
            aria-describedby="deployment-diagram-description"
          >
            <p class="drawing-kicker" id="deployment-diagram-title">
              THE DEPLOYMENT GOAL
            </p>
            <div class="deployment-boundary">
              <p class="boundary-label">
                <svg
                  width="16"
                  height="19"
                  viewBox="0 0 16 19"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M4 8V5a4 4 0 0 1 8 0v3M2 8h12v9H2z"
                    stroke="currentColor"
                    stroke-width="1.3"
                  />
                  <path d="M8 11v3" stroke="currentColor" stroke-width="1.3" />
                </svg>
                Client-approved environment
              </p>
              <div class="drawing-input">
                <span>01 / INPUT</span>
                <p>Your text or audio</p>
              </div>
              <div class="drawing-connection" aria-hidden="true"></div>
              <div class="drawing-model">
                <svg
                  class="model-symbol"
                  width="74"
                  height="74"
                  viewBox="0 0 74 74"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M37 6 64 22v30L37 68 10 52V22L37 6Z"
                    stroke="currentColor"
                  />
                  <path
                    d="m10 22 27 15 27-15M37 37v31M37 6v31M10 52l27-15 27 15"
                    stroke="currentColor"
                    opacity=".45"
                  />
                  <path
                    d="m37 22 13 7.5v15L37 52l-13-7.5v-15L37 22Z"
                    fill="currentColor"
                    fill-opacity=".12"
                    stroke="currentColor"
                  />
                  <circle cx="37" cy="37" r="3" fill="currentColor" />
                </svg>
                <div>
                  <span>02 / FOCUSED MODEL</span>
                  <p>One defined task.</p>
                </div>
              </div>
              <div class="drawing-connection" aria-hidden="true"></div>
              <div class="drawing-input">
                <span>03 / OUTPUT</span>
                <p>A useful result</p>
              </div>
              <div class="drawing-controls">
                <span>Hosting</span>
                <span>Access</span>
                <span>Data handling</span>
              </div>
            </div>
          </div>
          <figcaption id="deployment-diagram-description">
            An illustration of the intended deployment. The environment and
            operating arrangements are agreed for each project.
          </figcaption>
        </figure>
      </header>

      <nav class="development-contents" aria-label="On this page">
        <a href="#directions">
          <span>01</span> Model directions
        </a>
        <a href="#deployment">
          <span>02</span> Deployment &amp; data
        </a>
        <a href="#efficiency">
          <span>03</span> Operating cost
        </a>
        <a href="#evaluation">
          <span>04</span> Evaluation &amp; releases
        </a>
      </nav>

      <aside
        class="programme-context"
        aria-labelledby="programme-context-title"
      >
        <h2 id="programme-context-title">
          Current services and model research
        </h2>
        <p>
          Our custom client solutions use established models today. This
          programme develops smaller proprietary models for future use in those
          systems. Its focus is text and speech, tailored to a particular task,
          language or domain. A future workflow-design experience is explored in
          our{' '}
          <a href="/research-development/workflow-designer/">
            workflow designer
          </a>
          . See how we combine established models in{' '}
          <a href="/solutions/">custom client solutions</a>.
        </p>
      </aside>

      <section
        id="directions"
        class="development-section"
        aria-labelledby="directions-title"
      >
        <div class="development-section-heading">
          <div>
            <h2 id="directions-title">Model development directions</h2>
          </div>
          <p>
            These five directions define the work we’re pursuing. Examples below
            illustrate intended behaviour; they are not outputs from live models
            or reported performance results.
          </p>
        </div>
        {groups.map((group) => (
          <section
            class="direction-group"
            aria-labelledby={`${group.id}-models-title`}
          >
            <header class="direction-group-heading">
              <h3 id={`${group.id}-models-title`}>{group.title}</h3>
              <p>{group.copy}</p>
            </header>
            {modelDirections
              .filter((model) => model.group === group.id)
              .map((model) => (
                <article
                  class="model-direction"
                  id={model.id}
                  aria-labelledby={`${model.id}-title`}
                >
                  <div class="direction-number" aria-hidden="true">
                    {model.number}
                  </div>
                  <div class="direction-description">
                    <p class="direction-type">{model.type}</p>
                    <h4 id={`${model.id}-title`}>{model.name}</h4>
                    <p>{model.description}</p>
                    <a class="development-link" href={model.href}>
                      {model.link}
                    </a>
                  </div>
                  <div class="direction-specifics">
                    <span class="direction-label">Development direction</span>
                    <dl>
                      <div>
                        <dt>What we tailor</dt>
                        <dd>{model.specialisation}</dd>
                      </div>
                      <div>
                        <dt>What we evaluate</dt>
                        <dd>{model.evaluation}</dd>
                      </div>
                    </dl>
                    <details class="model-example">
                      <summary>
                        Illustrative example
                        <span class="disclosure-symbol" aria-hidden="true">
                          +
                        </span>
                      </summary>
                      <div class="example-body">
                        <p class="example-label">{model.example.label}</p>
                        <blockquote>{model.example.input}</blockquote>
                        <dl>
                          {model.example.output.map(([label, value]) => (
                            <div>
                              <dt>{label}</dt>
                              <dd>{value}</dd>
                            </div>
                          ))}
                        </dl>
                        <p class="example-note">{model.example.note}</p>
                      </div>
                    </details>
                  </div>
                </article>
              ))}
          </section>
        ))}
      </section>

      <section
        id="deployment"
        class="development-section"
        aria-labelledby="deployment-title"
      >
        <div class="development-section-heading">
          <div>
            <h2 id="deployment-title">Deployment and data control</h2>
          </div>
          <p>
            Self-hosting gives an organisation more choice over where model
            processing happens. Who operates the system and who can access data
            are separate decisions. We’re designing towards these deployment
            options as the models mature.
          </p>
        </div>
        <div class="deployment-options">
          {deploymentOptions.map((option) => (
            <article class="deployment-option">
              <span class="option-number">{option.number}</span>
              <h3>{option.name}</h3>
              <p>{option.description}</p>
              <dl>
                <div>
                  <dt>Data &amp; access</dt>
                  <dd>{option.control}</dd>
                </div>
                <div>
                  <dt>Operating cost</dt>
                  <dd>{option.cost}</dd>
                </div>
              </dl>
            </article>
          ))}
        </div>
        <p class="deployment-note">
          Data location, administrative access, logging and retention need to be
          defined for the whole deployment. Self-hosting is one part of that
          design. Supported configurations will be documented with each
          evaluated model.
        </p>
      </section>

      <section
        id="efficiency"
        class="development-section"
        aria-labelledby="efficiency-title"
      >
        <div class="development-section-heading">
          <div>
            <h2 id="efficiency-title">
              Efficiency has to
              <br />
              <span>hold up in use.</span>
            </h2>
          </div>
          <p>
            A smaller model can need less computing capacity. The actual cost
            also depends on traffic, simultaneous users, response times and how
            much hardware sits idle. Our goal is to make private deployment
            practical for the workload it serves.
          </p>
        </div>
        <div class="efficiency-grid">
          <div class="efficiency-methods">
            <h3>Methods we evaluate</h3>
            <dl>
              <div>
                <dt>Task-specific training</dt>
                <dd>
                  Shape a suitable starting model around a defined task and
                  representative examples.
                </dd>
              </div>
              <div>
                <dt>Distillation &amp; quantisation</dt>
                <dd>
                  Explore smaller students or lower-precision weights, then
                  check the effect on task quality.
                </dd>
              </div>
              <div>
                <dt>Serving around the workload</dt>
                <dd>
                  Evaluate batching, reuse and capacity sizing where they fit.
                  Live speech and overnight document processing have different
                  needs.
                </dd>
              </div>
            </dl>
          </div>
          <div class="measurement-panel">
            <h3>Evaluation criteria</h3>
            <dl>
              <div>
                <dt>Task quality</dt>
                <dd>Accuracy and failure cases on a defined test set.</dd>
              </div>
              <div>
                <dt>Memory &amp; hardware</dt>
                <dd>
                  Tested equipment, model size and memory required to run it.
                </dd>
              </div>
              <div>
                <dt>Responsiveness</dt>
                <dd>
                  Response time and throughput at a stated number of
                  simultaneous requests.
                </dd>
              </div>
              <div>
                <dt>Operating cost</dt>
                <dd>
                  Cost per completed task or minute of speech, including hosting
                  and operation at a stated workload.
                </dd>
              </div>
            </dl>
            <p class="measurement-note">
              These are evaluation criteria. Model-specific measurements will be
              shared as the work is validated.
            </p>
          </div>
        </div>
      </section>

      <section
        id="evaluation"
        class="development-section"
        aria-labelledby="evaluation-title"
      >
        <div class="development-section-heading">
          <div>
            <h2 id="evaluation-title">Evaluation and releases</h2>
          </div>
          <p>
            Useful development starts with a baseline and a way to recognise an
            improvement. Quality, deployment requirements and cost need to be
            assessed together before a model enters a client workflow.
          </p>
        </div>
        <ol class="evaluation-stages">
          {evaluationStages.map((stage, index) => (
            <li>
              <span aria-hidden="true">0{index + 1}</span>
              <h3>{stage.name}</h3>
              <p>{stage.copy}</p>
            </li>
          ))}
        </ol>
        <div class="release-status" aria-labelledby="release-status-title">
          <div>
            <p class="development-status">
              <span aria-hidden="true"></span> Programme in development
            </p>
            <h3 id="release-status-title">
              Proprietary model releases are still ahead.
            </h3>
          </div>
          <div>
            <p>
              Model downloads and release packages are not available on this
              page yet. Evaluated releases will describe intended use, training
              approach, tested hardware, results and limitations, together with
              licensing and access options.
            </p>
            <p class="release-status-note">
              Our custom client solutions use established models.
            </p>
          </div>
        </div>
      </section>

      <section class="development-questions" aria-labelledby="questions-title">
        <h2 id="questions-title">A few practical questions.</h2>
        <div>
          <details>
            <summary>
              Can you build a solution while these models are in development?
              <span class="disclosure-symbol" aria-hidden="true">
                +
              </span>
            </summary>
            <p>
              Yes. Our custom client solutions use established models today. The
              proprietary model programme is intended to extend the deployment
              choices available for future projects.
            </p>
          </details>
          <details>
            <summary>
              Will a smaller model run on our existing hardware?
              <span class="disclosure-symbol" aria-hidden="true">
                +
              </span>
            </summary>
            <p>
              That depends on the model, workload and response-time
              requirements. Hardware suitability needs to be tested for the
              intended use. Each evaluated model will include its tested
              requirements so a deployment can be assessed against your
              environment.
            </p>
          </details>
          <details>
            <summary>
              Who would have access to our data?
              <span class="disclosure-symbol" aria-hidden="true">
                +
              </span>
            </summary>
            <p>
              That follows the operating arrangement. A client-operated
              deployment and a QWERTY Labs-hosted deployment have different
              access requirements. Hosting location, operational permissions,
              logging and retention need to be agreed before deployment.
            </p>
          </details>
        </div>
      </section>

      <section
        class="development-reading"
        aria-labelledby="development-reading-title"
      >
        <div class="reading-heading">
          <div>
            <h2 id="development-reading-title">From the journal.</h2>
          </div>
          <a class="development-link" href="/blog/">
            Browse the journal
          </a>
        </div>
        <p class="reading-intro">
          Research and engineering context for this work.
        </p>
        <div class="development-reading-grid">
          {reading.map((post) => (
            <a href={`/blog/${post.id}/`}>
              <span>{post.data.category}</span>
              <h3>{post.data.title}</h3>
              <span class="reading-link-label">Read the article</span>
            </a>
          ))}
        </div>
      </section>

      <section class="development-cta" aria-labelledby="development-cta-title">
        <h2 id="development-cta-title">
          Have a task
          <br />
          <span>or language in mind?</span>
        </h2>
        <p>
          Tell us what the model needs to do, the examples you can provide and
          where it would need to run.
        </p>
        <a
          class="button button-dark"
          href={enquiryHref('contact', 'proprietary-models')}
        >
          Discuss your use case
        </a>
      </section>
    </div>
  </main>
</Editorial>
