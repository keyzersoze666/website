---
import { render, type CollectionEntry } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { publishedPosts } from '../../scripts/blog-content';
export async function getStaticPaths() {
  return (await publishedPosts()).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const related = (await publishedPosts())
  .filter((item) => item.id !== post.id)
  .sort(
    (a, b) =>
      Number(b.data.category === post.data.category) -
      Number(a.data.category === post.data.category)
  )
  .slice(0, 2);
---

<Article post={post} headings={headings} related={related}>
  <Content />
</Article>
