---
interface Props {
  src: string;
  class?: string;
  label?: string;
}
const { src, class: className, label } = Astro.props;
// Embed local artwork at build time: no mask fetch, loading state or client JS.
const assets = import.meta.glob<string>('/public/{brand,journal}/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const source = assets[`/public${src}`];
if (!source) throw new Error(`Missing SVG artwork: ${src}`);
const svg = source
  .replace(/\s(?:role|aria-label)="[^"]*"/g, '')
  .replace('<svg', '<svg aria-hidden="true" focusable="false"');
---

<span
  class:list={['svg-asset', className]}
  data-svg-src={src}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <Fragment set:html={svg} />
</span>
