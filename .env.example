# Primary HTTPS origin. Vercel Production uses this domain by default.
# Override SITE_URL in Vercel if the primary domain changes, then redeploy.
SITE_URL=https://samvitlabs.com
# Set false while a public production domain is still being prepared.
SITE_INDEXABLE=true
# Public Turnstile site key, restricted to your hostname in Cloudflare.
PUBLIC_TURNSTILE_SITE_KEY=
# Server-only settings. Never add PUBLIC_ to these names or commit real values.
TURNSTILE_SECRET_KEY=
GOOGLE_APPS_SCRIPT_URL=
ENQUIRY_SHARED_SECRET=
