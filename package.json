{
  "name": "samvit-labs-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "build": "astro build && node scripts/finalize-site.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:journal": "node scripts/validate-journal.mjs --built --count=18 --from=2025-12-01 --to=2026-09-30",
    "validate:site": "node scripts/validate-site.mjs",
    "figures:journal": "python3 scripts/generate-journal-figures.py"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "astro": "7.3.5",
    "gsap": "3.15.0",
    "katex": "0.18.9",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.0",
    "@types/three": "0.186.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3"
  },
  "description": "Company website, research journal and workflow designer for SAMVIT Labs.",
  "overrides": {
    "katex": "$katex"
  }
}
